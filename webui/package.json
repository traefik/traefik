{
  "name": "traefik-proxy-dashboard",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "scripts": {
    "build": "vite build",
    "build:prod": "yarn test && yarn tsc && yarn lint && yarn build",
    "dev": "vite",
    "format": "prettier './src/**/*.{ts,tsx}' --config .prettierrc.json --write",
    "lint": "eslint './src/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix './src/**/*.{ts,tsx}'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:unit:ci": "vitest run"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "prettier --config .prettierrc.json --write",
      "eslint --fix"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "module",
  "dependencies": {
    "@eslint/js": "9.39.5",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "14.6.8",
    "@traefik-labs/faency": "12.3.9",
    "@types/lodash": "4.17.27",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/web-worker": "4.1.12",
    "chart.js": "4.6.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "framer-motion": "^11.18.2",
    "globals": "16.5.0",
    "jest-extended": "^4.0.2",
    "jsdom": "29.1.1",
    "lodash": "4.18.1",
    "msw": "2.15.0",
    "query-string": "^6.9.0",
    "react": "^18.2.0",
    "react-chartjs-2": "5.3.1",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.12",
    "react-helmet-async": "^2.0.4",
    "react-icons": "5.7.0",
    "react-infinite-scroll-hook": "^4.1.1",
    "react-router": "7.18.5",
    "swr": "2.5.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "8.72.1",
    "usehooks-ts": "^2.14.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vitest-canvas-mock": "^0.3.3"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "^15.0.0",
    "prettier": "3.9.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "resolutions": {
    "@vanilla-extract/css": "1.21.3"
  }
