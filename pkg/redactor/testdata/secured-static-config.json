{
  "global": {
    "checkNewVersion": true,
    "sendAnonymousUsage": true
  },
  "serversTransport": {
    "insecureSkipVerify": true,
    "rootCAs": [
      "RootCAs 1",
      "RootCAs 2",
      "RootCAs 3"
    ],
    "maxIdleConnsPerHost": 111,
    "forwardingTimeouts": {
      "dialTimeout": "1m51s",
      "responseHeaderTimeout": "1m51s",
      "idleConnTimeout": "1m51s"
    }
  },
  "tcpServersTransport": {
    "dialKeepAlive": "1m51s",
    "dialTimeout": "1m51s",
    "tls": {
      "insecureSkipVerify": true,
      "rootCAs": [
        "RootCAs 1",
        "RootCAs 2",
        "RootCAs 3"
      ]
    }
  },
  "entryPoints": {
    "foobar": {
      "address": "foo Address",
      "transport": {
        "lifeCycle": {
          "requestAcceptGraceTimeout": "1m51s",
          "graceTimeOut": "1m51s"
        },
        "respondingTimeouts": {
          "readTimeout": "1m51s",
          "writeTimeout": "1m51s",
          "idleTimeout": "1m51s"
        }
      },
      "proxyProtocol": {
        "insecure": true,
        "trustedIPs": [
          "127.0.0.1/32",
          "192.168.0.1"
        ]
      },
      "forwardedHeaders": {
        "insecure": true,
        "trustedIPs": [
          "127.0.0.1/32",
          "192.168.0.1"
        ]
      },
      "http": {
        "redirections": {
          "entryPoint": {
            "to": "foobar",
            "scheme": "foobar",
            "permanent": true,
            "priority": 42
          }
        },
        "middlewares": [
          "foobar",
          "foobar"
        ],
        "tls": {
          "options": "foobar",
          "certResolver": "foobar",
          "domains": [
            {
              "main": "foobar",
              "sans": [
                "foobar",
                "foobar"
              ]
            }
          ]
        }
      }
    }
  },
  "providers": {
    "providersThrottleDuration": "1m51s",
    "docker": {
      "exposedByDefault": true,
      "constraints": "Label(\"foo\", \"bar\")",
      "allowEmptyServices": true,
      "network": "MyNetwork",
      "useBindPortIP": true,
      "watch": true,
      "defaultRule": "PathPrefix(`/`)",
      "username": "MyUsername",
      "password": "xxxx",
      "endpoint": "MyEndPoint",
      "tls": {
        "ca": "myCa",
        "cert": "mycert.pem",
        "key": "xxxx",
        "insecureSkipVerify": true
      },
      "httpClientTimeout": "42ns"
    },
    "swarm": {
      "exposedByDefault": true,
      "constraints": "Label(\"foo\", \"bar\")",
      "allowEmptyServices": true,
      "network": "MyNetwork",
      "useBindPortIP": true,
      "watch": true,
      "defaultRule": "PathPrefix(`/`)",
      "username": "MyUsername",
      "password": "xxxx",
      "endpoint": "MyEndPoint",
      "tls": {
        "ca": "myCa",
        "cert": "mycert.pem",
        "key": "xxxx",
        "insecureSkipVerify": true
      },
      "httpClientTimeout": "42ns",
      "refreshSeconds": "42ns"
    },
    "file": {
      "directory": "file Directory",
      "watch": true,
      "filename": "file Filename",
      "debugLogGeneratedTemplate": true
    },
    "kubernetesIngress": {
      "endpoint": "MyEndpoint",
      "token": "xxxx",
      "certAuthFilePath": "MyCertAuthPath",
      "namespaces": [
        "a",
        "b"
      ],
      "labelSelector": "myLabelSelector",
      "ingressClass": "MyIngressClass",
      "ingressEndpoint": {
        "ip": "IP",
        "hostname": "Hostname",
        "publishedService": "PublishedService"
      },
      "throttleDuration": "1m51s"
    },
    "kubernetesCRD": {
      "endpoint": "MyEndpoint",
      "token": "xxxx",
      "certAuthFilePath": "MyCertAuthPath",
      "namespaces": [
        "a",
        "b"
      ],
      "labelSelector": "myLabelSelector",
      "ingressClass": "MyIngressClass",
      "throttleDuration": "1m51s"
    },
    "kubernetesGateway": {
      "endpoint": "MyEndpoint",
      "token": "xxxx",
      "certAuthFilePath": "MyCertAuthPath",
      "namespaces": [
        "a",
        "b"
      ],
      "labelSelector": "myLabelSelector",
      "throttleDuration": "1m51s"
    },
    "knative": {
      "endpoint": "MyEndpoint",
      "token": "xxxx",
      "certAuthFilePath": "MyCertAuthPath",
      "namespaces": [
        "a",
        "b"
      ],
      "labelSelector": "myLabelSelector",
      "publicService": {},
      "privateService": {},
      "throttleDuration": "1m51s"
    },
    "rest": {
      "insecure": true
    },
    "consulCatalog": {
      "constraints": "Label(\"foo\", \"bar\")",
      "endpoint": {
        "address": "MyAddress",
        "scheme": "MyScheme",
        "datacenter": "MyDatacenter",
        "token": "xxxx",
        "tls": {
          "ca": "myCa",
          "cert": "mycert.pem",
          "key": "xxxx",
          "insecureSkipVerify": true
        },
        "httpAuth": {
          "username": "xxxx",
          "password": "xxxx"
        },
        "endpointWaitTime": "42ns"
      },
      "prefix": "MyPrefix",
      "refreshInterval": "42ns",
      "requireConsistent": true,
      "stale": true,
      "cache": true,
      "exposedByDefault": true,
      "defaultRule": "PathPrefix(`/`)",
      "namespaces": [
        "ns1",
        "ns2"
      ]
    },
    "ecs": {
      "constraints": "Label(\"foo\", \"bar\")",
      "exposedByDefault": true,
      "refreshSeconds": 42,
      "defaultRule": "PathPrefix(`/`)",
      "clusters": [
        "Cluster1",
        "Cluster2"
      ],
      "autoDiscoverClusters": true,
      "ecsAnywhere": true,
      "region": "Awsregion",
      "accessKeyID": "xxxx",
      "secretAccessKey": "xxxx"
    },
    "consul": {
      "rootKey": "RootKey",
      "token": "xxxx",
      "tls": {
        "ca": "myCa",
        "cert": "mycert.pem",
        "key": "xxxx",
        "insecureSkipVerify": true
      },
      "namespaces": [
        "ns1",
        "ns2"
      ]
    },
    "etcd": {
      "rootKey": "RootKey",
      "tls": {
        "ca": "myCa",
        "cert": "mycert.pem",
        "key": "xxxx",
        "insecureSkipVerify": true
      },
      "username": "xxxx",
      "password": "xxxx"
    },
    "zooKeeper": {
      "rootKey": "RootKey",
      "username": "xxxx",
      "password": "xxxx"
    },
    "redis": {
      "rootKey": "RootKey",
      "tls": {
        "ca": "myCa",
        "cert": "mycert.pem",
        "key": "xxxx",
        "insecureSkipVerify": true
      },
      "username": "xxxx",
      "password": "xxxx"
    },
    "http": {
      "endpoint": "Myendpoint",
      "pollInterval": "42ns",
      "pollTimeout": "42ns",
      "tls": {
        "ca": "myCa",
        "cert": "mycert.pem",
        "key": "xxxx",
        "insecureSkipVerify": true
      }
    }
  },
  "api": {
    "insecure": true,
    "dashboard": true,
    "debug": true
  },
  "metrics": {
    "prometheus": {
      "buckets": [
        0.1,
        0.3,
        1.2,
        5
      ],
      "addEntryPointsLabels": true,
      "addServicesLabels": true,
      "entryPoint": "MyEntryPoint",
      "manualRouting": true
    },
    "datadog": {
      "address": "localhost:8181",
      "pushInterval": "42ns",
      "addEntryPointsLabels": true,
      "addServicesLabels": true
    },
    "statsD": {
      "address": "localhost:8182",
      "pushInterval": "42ns",
      "addEntryPointsLabels": true,
      "addServicesLabels": true,
      "prefix": "MyPrefix"
    }
  },
  "ping": {
    "entryPoint": "MyEntryPoint",
    "manualRouting": true,
    "terminatingStatusCode": 42
  },
  "log": {
    "level": "Level",
    "format": "json",
    "filePath": "/foo/path",
    "maxSize": 5,
    "maxAge": 3,
    "maxBackups": 4,
    "compress": true,
    "otlp": {
      "serviceName": "foobar",
      "resourceAttributes": {
        "foobar": "foobar"
      },
      "grpc": {
        "endpoint": "foobar",
        "insecure": true,
        "headers": {
          "foobar": "foobar"
        }
      },
      "http": {
        "endpoint": "foobar",
        "headers": {
          "foobar": "foobar"
        }
      }
    }
  },
  "accessLog": {
    "filePath": "AccessLog FilePath",
    "format": "AccessLog Format",
    "filters": {
      "statusCodes": [
        "200",
        "500"
      ],
      "retryAttempts": true,
      "minDuration": "42ns"
    },
    "fields": {
      "defaultMode": "drop",
      "names": {
        "RequestHost": "keep"
      },
      "headers": {
        "defaultMode": "drop",
        "names": {
          "Referer": "keep"
        }
      }
    },
    "bufferingSize": 42,
    "otlp": {
      "serviceName": "foobar",
      "resourceAttributes": {
        "foobar": "foobar"
      },
      "grpc": {
        "endpoint": "foobar",
        "insecure": true,
        "headers": {
          "foobar": "foobar"
        }
      },
      "http": {
        "endpoint": "foobar",
        "headers": {
          "foobar": "foobar"
        }
      }
    }
  },
  "tracing": {
    "serviceName": "myServiceName",
    "resourceAttributes": {
      "foobar": "foobar"
    },
    "sampleRate": 42,
    "otlp": {
      "grpc": {
        "endpoint": "foobar",
        "insecure": true,
        "headers": {
          "foobar": "foobar"
        }
      },
      "http": {
        "endpoint": "foobar",
        "headers": {
          "foobar": "foobar"
        }
      }
    },
    "globalAttributes": {
      "foobar": "foobar"
    }
  },
  "hostResolver": {
    "cnameFlattening": true,
    "resolvConfig": "foobar",
    "resolvDepth": 42
  },
  "certificatesResolvers": {
    "CertificateResolver0": {
      "acme": {
        "email": "acme Email",
        "caServer": "CAServer",
        "preferredChain": "foobar",
        "storage": "Storage",
        "keyType": "MyKeyType",
        "certificatesDuration": 42,
        "dnsChallenge": {
          "provider": "DNSProvider",
          "resolvers": [
            "resolver1",
            "resolver2"
          ],
          "propagation": {
            "disableChecks": true,
            "disableANSChecks": true,
            "requireAllRNS": true,
            "delayBeforeChecks": "42ns"
          },
          "delayBeforeCheck": "42ns",
          "disablePropagationCheck": true
        },
        "httpChallenge": {
          "entryPoint": "MyEntryPoint"
        },
        "tlsChallenge": {}
      }
    }
