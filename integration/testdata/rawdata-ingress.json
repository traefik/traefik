	"middlewares": {
		"dashboard_redirect@internal": {
			"redirectRegex": {
				"regex": "^(http:\\/\\/(\\[[\\w:.]+\\]|[\\w\\._-]+)(:\\d+)?)\\/$",
				"replacement": "${1}/dashboard/",
				"permanent": true
			},
			"status": "enabled",
			"usedBy": [
				"dashboard@internal"
			]
		},
		"dashboard_stripprefix@internal": {
			"stripPrefix": {
				"prefixes": [
